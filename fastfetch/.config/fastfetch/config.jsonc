{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 12
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": " "
  },
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/rickandmorty.png",
    "width": 23,
    "height": 11
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "󰀄  user",
      "keyColor": "magenta",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "󰍹  os",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "󰌽  ker",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "󰏖  pkgs",
      "keyColor": "cyan",
      "disabled": ["brew-cask"]
    },
    {
      "type": "shell",
      "key": "󰞷  sh",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "󰆍  term",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "󰅐  up",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "󰍛  cpu",
      "keyColor": "red",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰘚  ram",
      "keyColor": "yellow",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "󰋊  disk",
      "keyColor": "cyan",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m󰮯 \u001b[32m󰊠 \u001b[34m󰊠 \u001b[31m󰊠 \u001b[36m󰊠 \u001b[35m󰊠 \u001b[37m󰊠 \u001b[37m󰊠 "
    }
  ]
}
